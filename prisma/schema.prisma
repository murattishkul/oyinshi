// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Admin {
  id         Int      @id @default(autoincrement())
  telegramId String   @unique
  username   String?
  firstName  String?
  lastName   String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  games Game[]

  @@map("admins")
}

model Game {
  id           Int        @id @default(autoincrement())
  adminId      Int
  groupId      String // This stores the Telegram group ID
  date         DateTime
  playersCount Int
  location     String
  status       GameStatus @default(ACTIVE)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  admin        Admin         @relation(fields: [adminId], references: [id], onDelete: Cascade)
  participants Participant[]
  group        Group         @relation(fields: [groupId], references: [telegramId])

  @@map("games")
}

model Participant {
  id         Int               @id @default(autoincrement())
  gameId     Int
  telegramId String
  username   String?
  firstName  String?
  lastName   String?
  status     ParticipantStatus @default(GOING)
  createdAt  DateTime          @default(now())
  updatedAt  DateTime          @updatedAt

  isAddedByUser Boolean @default(false)
  addedByUserId String?

  game Game @relation(fields: [gameId], references: [id], onDelete: Cascade)

  // Ensure one user can only participate once per game
  @@unique([gameId, telegramId])
  @@map("participants")
}

model Group {
  id         Int      @id @default(autoincrement())
  telegramId String   @unique
  title      String
  type       String // "group", "supergroup", "channel"
  username   String? // Group username if it has one (e.g., @myfootballgroup)
  isActive   Boolean  @default(true)
  addedAt    DateTime @default(now())
  updatedAt  DateTime @updatedAt

  games Game[]

  @@map("groups")
}

enum GameStatus {
  ACTIVE
  COMPLETED
  CANCELLED
}

enum ParticipantStatus {
  GOING
  NOT_GOING
  MAYBE
}
