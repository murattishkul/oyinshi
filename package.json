{
  "name": "oyinshi",
  "version": "1.0.0",
  "main": "index.js",
  "description": "Telegram bot for organizing football games",
  "scripts": {
    "start": "node index.js",
    "dev": "nodemon index.js",
    "test": "jest --detectOpenHandles --forceExit",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "lint": "eslint . --ext .js",
    "lint:fix": "eslint . --ext .js --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:migrate": "npx prisma migrate dev",
    "db:generate": "npx prisma generate",
    "db:deploy": "npx prisma migrate deploy",
    "db:reset": "npx prisma migrate reset --force",
    "db:seed": "node prisma/seed.js",
    "docker:build": "docker build -t oyinshi .",
    "docker:run": "docker run -p 3000:3000 --env-file .env oyinshi",
    "health": "curl -f http://localhost:3000/health || exit 1"
  },
  "keywords": [
    "telegram",
    "bot",
    "football",
    "sports",
    "oyinshi"
  ],
  "author": "murattishkul",
  "license": "MIT",
  "dependencies": {
    "@prisma/client": "^5.19.1",
    "body-parser": "^1.20.3",
    "dotenv": "^16.4.5",
    "express": "^4.21.0",
    "node-telegram-bot-api": "^0.66.0"
  },
  "devDependencies": {
    "nodemon": "^3.1.4",
    "prisma": "^5.19.1",
    "jest": "^29.6.2",
    "supertest": "^6.3.3",
    "eslint": "^8.45.0",
    "eslint-config-standard": "^17.1.0",
    "prettier": "^3.0.0"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=8.0.0"
  }
}
